# VelvetLog Environment Configuration Template
# Copy this file to .env.local and update with your actual values

# Application
NODE_ENV=development
PORT=5000

# Database Configuration
# Get this from Replit Database or your PostgreSQL instance
DATABASE_URL=postgresql://username:password@host:port/database

# Security Keys (Generate secure random values)
# Use: openssl rand -hex 32
SESSION_SECRET=your_very_secure_session_secret_here_32_chars_minimum
MASTER_ENCRYPTION_KEY=your_master_encryption_key_here_64_chars_recommended

# Multi-Factor Authentication
MFA_ISSUER=VelvetLog
MFA_ALGORITHM=SHA1

# Optional: Monitoring and Analytics
# SENTRY_DSN=your_sentry_dsn_for_error_tracking
# ANALYTICS_KEY=your_analytics_service_key

# Optional: External Services
# OPENAI_API_KEY=your_openai_api_key_for_ai_features
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Optional: Cloud Storage
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=velvetlog-uploads

# Optional: Email Service
# SMTP_HOST=your_smtp_host
# SMTP_PORT=587
# SMTP_USER=your_email_username
# SMTP_PASS=your_email_password
# FROM_EMAIL=noreply@velvetlog.app

# Development Tools
LOG_LEVEL=info
DEBUG_MODE=false

# Backup Configuration
BACKUP_ENCRYPTION_KEY=your_backup_encryption_passphrase
BACKUP_RETENTION_DAYS=30

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_COOKIE_MAX_AGE=604800000
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=strict

# CORS Configuration
CORS_ORIGIN=https://your-domain.com
CORS_CREDENTIALS=true

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_AI_FEATURES=true
ENABLE_BIOMETRIC_AUTH=true
ENABLE_CLOUD_BACKUP=false

# API Versioning
API_VERSION=v1
API_BASE_PATH=/api